### ============================================
### 4. ИЗВЛЕЧЕНИЕ ID ДОЧЕРНИХ СУЩНОСТЕЙ
### ИСПРАВЛЕНО: resultInstance теперь внутри tr.resultDefinition
### ============================================

# @name getStudyDetails
GET {{laboratoryOperationsUrl}}/api/samples/{{sampleId}}/studies/{{studyId}}

> {%
  client.test("Get study details", function () {
    client.assert(response.status === 200, "Failed to get study details");

    const study = response.body;

    const massBefore = study.measuredValues.find(mv => mv.inputParameter.aliasName === "m1");
    const massAfter = study.measuredValues.find(mv => mv.inputParameter.aliasName === "m2");
    const emptyMass = study.measuredValues.find(mv => mv.inputParameter.aliasName === "m0");

    // TestResultDto.ResultDefinition — вложенный объект, resultInstance внутри него
    const moistureResult = study.testResults.find(tr =>
      tr.resultDefinition && tr.resultDefinition.resultInstance.includes("Вода"));
    const dryMatterResult = study.testResults.find(tr =>
      tr.resultDefinition && tr.resultDefinition.resultInstance.includes("Сухое вещество"));

    if (massBefore) client.global.set("massBeforeMvId", massBefore.id);
    if (massAfter) client.global.set("massAfterMvId", massAfter.id);
    if (emptyMass) client.global.set("emptyMassMvId", emptyMass.id);

    if (moistureResult) client.global.set("moistureResultTrId", moistureResult.id);
    if (dryMatterResult) client.global.set("dryMatterResultTrId", dryMatterResult.id);

    client.log("MV IDs: m1=" + (massBefore ? massBefore.id : "NOT FOUND") +
      ", m2=" + (massAfter ? massAfter.id : "NOT FOUND") +
      ", m0=" + (emptyMass ? emptyMass.id : "NOT FOUND"));
    client.log("TR IDs: moisture=" + (moistureResult ? moistureResult.id : "NOT FOUND") +
      ", dryMatter=" + (dryMatterResult ? dryMatterResult.id : "NOT FOUND"));

    // Диагностика: если testResults пустые или без resultDefinition — покажем структуру
    if (study.testResults.length > 0 && !study.testResults[0].resultDefinition) {
      client.log("WARNING: testResults[0] has no resultDefinition. Keys: " +
        Object.keys(study.testResults[0]).join(", "));
    }
  });
%}

