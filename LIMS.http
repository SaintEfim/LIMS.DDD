### ============================================

# @name createUnitGram
POST {{unitServiceUrl}}/api/units
Content-Type: application/json

{
  "name": "г {{$random.code.ean13}}"
}

> {%
  client.test("Create unit 'г'", function () {
    client.assert(response.status === 201, "Unit 'г' creation failed: " + response.status);
  });
  client.global.set("unitGramId", response.body.id);
%}

