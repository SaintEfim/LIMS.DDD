### ============================================
### 8. ФИНАЛЬНАЯ ПРОВЕРКА
### ============================================

GET {{laboratoryOperationsUrl}}/api/samples/{{sampleId}}/studies/{{studyId}}

> {%
  client.test("Verify final study state", function () {
    client.assert(response.status === 200, "Failed to get final study");
    client.assert(response.body.status === "Completed", "Study status is not Completed");

    const moisture = response.body.testResults.find(tr =>
      tr.resultDefinition && tr.resultDefinition.resultInstance.includes("Вода"));
    if (moisture) {
      client.log("Moisture value: " + moisture.value + ", outOfSpec: " + moisture.isOutOfSpec);
    }

    client.log("Full LIMS workflow completed successfully");
  });
%}
