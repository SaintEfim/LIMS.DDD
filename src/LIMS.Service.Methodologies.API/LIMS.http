@baseUrl = http://localhost:1001
@unitServiceUrl = http://localhost:1003

### ============================================
### СОЗДАНИЕ UNITS (в Guides / Unit Service)
### ============================================

# @name createUnitGram
POST {{unitServiceUrl}}/api/units
Content-Type: application/json

{
  "name": "г"
}

> {%
  client.test("Create unit 'г'", function () {
    client.assert(response.status === 201, "Unit 'г' creation failed: " + response.status);
  });
  client.global.set("unitGramId", response.body.id);
  client.log("Unit 'г' ID: " + response.body.id);
%}

###

# @name createUnitPercent
POST {{unitServiceUrl}}/api/units
Content-Type: application/json

{
  "name": "%"
}

> {%
  client.test("Create unit '%'", function () {
    client.assert(response.status === 201, "Unit '%' creation failed: " + response.status);
  });
  client.global.set("unitPercentId", response.body.id);
  client.log("Unit '%' ID: " + response.body.id);
%}

### ============================================
### СОЗДАНИЕ МЕТОДИКИ 1: Определение влажности
### ============================================

# @name createMoistureTemplate
POST {{baseUrl}}/api/study-templates
Content-Type: application/json

{
  "name": "Определение влажности зерна {{$random.uuid}}",
  "description": "Методика определения массовой доли влаги в зерне воздушно-тепловым способом",
  "revision": "v1.0-{{$random.uuid}}"
}

> {%
  client.test("Create moisture template", function () {
    client.assert(response.status === 201, "Template creation failed: " + response.status);
  });
  client.global.set("moistureTemplateId", response.body.id);
  client.log("Moisture Template ID: " + response.body.id);
%}

### ============================================
### ДОБАВЛЕНИЕ ВХОДНЫХ ПАРАМЕТРОВ
### ============================================

# @name addMassBefore
POST {{baseUrl}}/api/study-templates/{{moistureTemplateId}}/input-parameters
Content-Type: application/json

{
  "aliasName": "m1",
  "name": "Масса бюксы с зерном до высушивания",
  "description": "Масса бюксы с навеской зерна до высушивания",
  "unitId": "{{unitGramId}}",
  "minValue": 10.0,
  "maxValue": 50.0
}

> {%
  client.test("Add mass before", function () {
    client.assert(response.status === 201, "Input parameter creation failed");
  });
  client.global.set("massBeforeId", response.body.id);
%}

###

# @name addMassAfter
POST {{baseUrl}}/api/study-templates/{{moistureTemplateId}}/input-parameters
Content-Type: application/json

{
  "aliasName": "m2",
  "name": "Масса бюксы с зерном после высушивания",
  "description": "Масса бюксы после высушивания при 130°C",
  "unitId": "{{unitGramId}}",
  "minValue": 8.0,
  "maxValue": 48.0
}

> {%
  client.test("Add mass after", function () {
    client.assert(response.status === 201, "Input parameter creation failed");
  });
  client.global.set("massAfterId", response.body.id);
%}

###

# @name addEmptyMass
POST {{baseUrl}}/api/study-templates/{{moistureTemplateId}}/input-parameters
Content-Type: application/json

{
  "aliasName": "m0",
  "name": "Масса пустой бюксы",
  "description": "Масса чистой сухой бюксы",
  "unitId": "{{unitGramId}}",
  "minValue": 5.0,
  "maxValue": 20.0
}

> {%
  client.test("Add empty mass", function () {
    client.assert(response.status === 201, "Input parameter creation failed");
  });
  client.global.set("emptyMassId", response.body.id);
%}

### ============================================
### ДОБАВЛЕНИЕ ОПРЕДЕЛЯЕМЫХ ПОКАЗАТЕЛЕЙ
### ============================================

# @name addMoistureResult
POST {{baseUrl}}/api/study-templates/{{moistureTemplateId}}/result-definitions
Content-Type: application/json

{
  "resultInstance": "Вода",
  "unitId": "{{unitPercentId}}",
  "minValue": 5.0,
  "maxValue": 20.0
}

> {%
  client.test("Add moisture result", function () {
    client.assert(response.status === 201, "Result definition creation failed");
  });
  client.global.set("moistureResultId", response.body.id);
%}

###

# @name addDryMatterResult
POST {{baseUrl}}/api/study-templates/{{moistureTemplateId}}/result-definitions
Content-Type: application/json

{
  "resultInstance": "Сухое вещество",
  "unitId": "{{unitPercentId}}",
  "minValue": 80.0,
  "maxValue": 95.0
}

> {%
  client.test("Add dry matter result", function () {
    client.assert(response.status === 201, "Result definition creation failed");
  });
  client.global.set("dryMatterResultId", response.body.id);
%}

### ============================================
### ДОБАВЛЕНИЕ ПРАВИЛ РАСЧЁТА
### ============================================

# @name addMoistureCalculation
POST {{baseUrl}}/api/study-templates/{{moistureTemplateId}}/calculation-rules
Content-Type: application/json

{
  "name": "Расчет влажности",
  "formulaExpression": "((m1 - m2) / (m1 - m0)) * 100",
  "description": "Формула расчета массовой доли влаги",
  "resultDefinitionId": "{{moistureResultId}}"
}

> {%
  client.test("Add moisture calculation", function () {
    client.assert(response.status === 201, "Calculation rule creation failed");
  });
  client.global.set("moistureCalcId", response.body.id);
%}

### ============================================
### ИЗМЕНЕНИЕ СТАТУСА (УТВЕРЖДЕНИЕ МЕТОДИКИ)
### ============================================

# @name approveMoistureTemplate
POST {{baseUrl}}/api/study-templates/{{moistureTemplateId}}/change-status?newStatus=Active

> {%
  client.test("Approve moisture template", function () {
    client.assert(response.status === 200, "Status change failed: " + response.status);
  });
  client.log("Moisture Template approved (Active)");
%}

### ============================================
### СОЗДАНИЕ НОВОЙ РЕДАКЦИИ (РЕВИЗИИ)
### ============================================

# @name createMoistureRevision
POST {{baseUrl}}/api/study-templates/{{moistureTemplateId}}/create-revision
Content-Type: application/json

{
  "newRevision": "v1.1-{{$random.uuid}}"
}

> {%
  client.test("Create revision", function () {
    client.assert(response.status === 201, "Revision creation failed: " + response.status);
  });
  client.global.set("moistureTemplateV2Id", response.body.id);
  client.log("Moisture Template V2 ID: " + response.body.id);
%}

### ============================================
### ПРОВЕРКА ЖИЗНЕННОГО ЦИКЛА
### ============================================

GET {{baseUrl}}/api/study-templates/{{moistureTemplateId}}

###

GET {{baseUrl}}/api/study-templates/{{moistureTemplateV2Id}}

### ============================================
### УТВЕРЖДЕНИЕ НОВОЙ РЕДАКЦИИ (V2)
### ============================================

POST {{baseUrl}}/api/study-templates/{{moistureTemplateV2Id}}/change-status?newStatus=Active

> {%
  client.test("Approve moisture template V2", function () {
    client.assert(response.status === 200, "Status change for V2 failed: " + response.status);
  });
  client.log("Moisture Template V2 approved (Active)");
%}
