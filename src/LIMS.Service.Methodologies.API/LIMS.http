#### ============================================
#### 5. ВВОД СЫРЫХ ДАННЫХ АНАЛИТИКОМ (MEASURED VALUES)
#### ============================================
#
## @name updateMassBefore
#PATCH {{baseUrl}}/api/studies/{{studyId}}/measured-values/{{massBeforeMvId}}
#Content-Type: application/json
#
#{
#  "value": 35.5
#}
#
####
#
## @name updateMassAfter
#PATCH {{baseUrl}}/api/studies/{{studyId}}/measured-values/{{massAfterMvId}}
#Content-Type: application/json
#
#{
#  "value": 32.1
#}
#
####
#
## @name updateEmptyMass
#PATCH {{baseUrl}}/api/studies/{{studyId}}/measured-values/{{emptyMassMvId}}
#Content-Type: application/json
#
#{
#  "value": 15.0
#}
#
#### ============================================
#### 6. ВВОД/ОБНОВЛЕНИЕ РЕЗУЛЬТАТОВ (TEST RESULTS)
#### В реальной системе это может делать движок расчетов, но здесь мы эмулируем результат
#### ============================================
#
## @name updateMoistureResult
#POST {{baseUrl}}/api/studies/{{studyId}}/test-results/{{moistureResultTrId}}/execute
#Content-Type: application/json
#
####
#
## @name updateDryMatterResult
#PATCH {{baseUrl}}/api/studies/{{studyId}}/test-results/{{dryMatterResultTrId}}
#Content-Type: application/json
#
#{
#  "value": 85.8,
#  "isOutOfSpec": false
#}
#
#### ============================================
#### 6. ЗАВЕРШЕНИЕ ИССЛЕДОВАНИЯ (CHANGE STATUS)
#### Переводим исследование из InWork в Completed
#### ============================================
#
## @name completeStudy
#POST {{baseUrl}}/api/samples/{{sampleId}}/studies/{{studyId}}/change-status
#Content-Type: application/json
#
#{
#  "status": "Completed"
#}
#
#> {%
