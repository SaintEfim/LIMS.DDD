### ============================================
### 3. СОЗДАНИЕ ИССЛЕДОВАНИЯ (STUDY) ПО МЕТОДИКЕ
### Система автоматически создаст MeasuredValues и TestResults на основе Snapshot шаблона
### ============================================

# @name createStudy
POST {{baseUrl}}/api/samples/{{sampleId}}/studies
Content-Type: application/json

{
  "templateId": "{{moistureTemplateV2Id}}"
}

> {%
  client.test("Create study", function () {
    client.assert(response.status === 201, "Study creation failed: " + response.status);
  });
  client.global.set("studyId", response.body.id);
  client.log("Study ID: " + response.body.id);
%}

### ============================================
### 4. ПОЛУЧЕНИЕ ИССЛЕДОВАНИЯ ДЛЯ ИЗВЛЕЧЕНИЯ ID ДОЧЕРНИХ СУЩНОСТЕЙ
### Нам нужно найти ID конкретных MeasuredValue и TestResult по их AliasName/ResultInstance
### ============================================

# @name getStudyDetails
GET {{baseUrl}}/api/samples/{{sampleId}}/studies/{{studyId}}

> {%
  client.test("Get study details", function () {
    client.assert(response.status === 200, "Failed to get study details");

    const study = response.body;

    // AliasName совпадают с переменными в формуле: m1, m2 и m0.
    const massBefore = study.measuredValues.find(mv => mv.parameterAlias === "m1");
    const massAfter = study.measuredValues.find(mv => mv.parameterAlias === "m2");
    const emptyMass = study.measuredValues.find(mv => mv.parameterAlias === "m0");

    // Ищем результаты
    const moistureResult = study.testResults.find(tr => tr.resultInstance.includes("Вода"));
    const dryMatterResult = study.testResults.find(tr => tr.resultInstance.includes("Сухое вещество"));

    if (massBefore) client.global.set("massBeforeMvId", massBefore.id);
    if (massAfter) client.global.set("massAfterMvId", massAfter.id);
    if (emptyMass) client.global.set("emptyMassMvId", emptyMass.id);

    if (moistureResult) client.global.set("moistureResultTrId", moistureResult.id);
    if (dryMatterResult) client.global.set("dryMatterResultTrId", dryMatterResult.id);

    client.log("Extracted MeasuredValue and TestResult IDs for updates");
  });
%}

### ============================================
### 5. ВВОД СЫРЫХ ДАННЫХ АНАЛИТИКОМ (MEASURED VALUES)
### ============================================

# @name updateMassBefore
PATCH {{baseUrl}}/api/studies/{{studyId}}/measured-values/{{massBeforeMvId}}
Content-Type: application/json

{
  "value": 35.5
}

###

# @name updateMassAfter
PATCH {{baseUrl}}/api/studies/{{studyId}}/measured-values/{{massAfterMvId}}
Content-Type: application/json

{
  "value": 32.1
}

###

# @name updateEmptyMass
PATCH {{baseUrl}}/api/studies/{{studyId}}/measured-values/{{emptyMassMvId}}
Content-Type: application/json

{
  "value": 15.0
}

### ============================================
### 6. ЗАВЕРШЕНИЕ ИССЛЕДОВАНИЯ (CHANGE STATUS)
### Переводим исследование из InWork в Completed
### ============================================

# @name completeStudy
POST {{baseUrl}}/api/samples/{{sampleId}}/studies/{{studyId}}/change-status
Content-Type: application/json

{
  "status": "Completed"
}

> {%
  client.test("Complete study", function () {
    client.assert(response.status === 204, "Study status change failed: " + response.status);
  });
  client.log("Study completed successfully");
%}

### ============================================
### 8. ФИНАЛЬНАЯ ПРОВЕРКА: ПОЛУЧЕНИЕ ГОТОВОГО ИССЛЕДОВАНИЯ
### Убеждаемся, что все данные сохранились и статус изменен
### ============================================

GET {{baseUrl}}/api/samples/{{sampleId}}/studies/{{studyId}}

> {%
  client.test("Verify final study state", function () {
    client.assert(response.status === 200, "Failed to get final study");
    client.assert(response.body.status === "Completed", "Study status is not Completed");
    client.assert(response.body.testResults[0].value !== null, "Test results should have values");
    client.log("Full LIMS workflow completed successfully");
  });
%}
